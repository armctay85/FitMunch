# ── Copy to `.env` locally (never commit). Sync to Vercel: `npm run env:vercel`
#
# Optional (only for npm run env:vercel — not used by the Node app at runtime):
# VERCEL_TOKEN=
# VERCEL_TARGET_PROJECT=fit-munch
# VERCEL_TEAM_ID=

NODE_ENV=production

# Required for login, API, Postgres
DATABASE_URL=
JWT_SECRET=

# Optional: extra allowed browser origins (comma-separated).
# Your *.vercel.app URL is added automatically from VERCEL_URL on Vercel.
# ALLOWED_ORIGINS=https://fitmunch.com.au,https://www.fitmunch.com.au

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# FitMunch Coach, Stripe TEST prices only. Live prices wait for the owner.
# Create them with: node scripts/create-coach-test-prices.js
# A$39/mo, up to 10 active clients, 14-day trial, card required:
# STRIPE_COACH_39_PRICE_ID=
# A$79/mo, unlimited active clients, 14-day trial, card required:
# STRIPE_COACH_79_PRICE_ID=

# Receipt AI / meal planner (optional)
# ANTHROPIC_API_KEY=

# AI coach (preferred: OpenAI). If both keys are set, OpenAI wins.
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini
# AI_FREE_MONTHLY_LIMIT=10

# Instagram posting (optional)
# INSTAGRAM_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=

# Business email (Resend only; never Gmail)
# RESEND_API_KEY=
# RESEND_FROM=FitMunch <hello@fitmunch.com.au>
# RESEND_REPLY_TO=
# Inbound support mail. Resend posts email.received to
# https://fitmunch.com.au/api/resend-inbound. The value is that webhook's
# Svix signing secret. Unset means every delivery is refused (401).
# RESEND_INBOUND_WEBHOOK_SECRET=
# Where support@fitmunch.com.au is forwarded. Unset means the webhook is
# accepted and nothing is sent. Reply-To on the forward is the original sender.
# SUPPORT_FORWARD_TO=drews+fitmunch-support@mail.grokbot.com

# Operator alerts. Comma-separated. The webhook retry alert uses this and
# falls back to support@fitmunch.com.au when unset. Failed-payment owner
# mail uses the same variable and is skipped (with a log line) when unset.
# No personal addresses belong in code.
# ALERT_EMAIL_TO=

# Preferred AI for coach (Vercel uses GEMINI_API_KEY in production)
# GEMINI_API_KEY=

# Private marketing funnel at /funnel (GET /api/analytics/funnel)
# FM_ANALYTICS_KEY=
