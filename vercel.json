{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --omit=dev",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self \"https://checkout.stripe.com\")"
        }
      ]
    }
  ],
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/price-memory/purge",
      "schedule": "15 16 * * *"
    }
  ]
}
